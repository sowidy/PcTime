# PcTime 客户端配置模板
#
# 用法：把这个文件复制成同目录的 .env，改里面的值，重启客户端。
# 打包版更省事：压缩包里已经带了它，直接改名成 .env 就行 ——
# 客户端就在 exe 旁边找这个文件。
#
# **没有 .env 是正常的**，客户端会照常跑，全部用代码里的默认值。
# 只有在「想改点什么」的时候才需要建这个文件。
#
# 客户端读 .env 的顺序（先找到的赢）：
#   1. exe 旁边       —— 解压出来那一层，最直观
#   2. %APPDATA%\PcTime\   —— 程序装在 Program Files 这类只读位置时用
# 到底读的是哪一份，设置页的「最近上传」那一块会写。
#
# 语法（不支持多行值和 ${OTHER} 插值）：
#   KEY=value        KEY="value"（认 \n 转义）   KEY='value'（原样保留）
#   export KEY=value  也能用；# 前面有空格才算行尾注释

# ── 服务端地址 ──────────────────────────────────────────────
# 换成自己的服务端时改这两行。域名也行（前面挂 Nginx 配 TLS 的话）。
PCTIME_SERVER_HOST=
PCTIME_SERVER_PORT=

# ── 上传节奏 ────────────────────────────────────────────────
# 单次请求超时（秒）
PCTIME_REQUEST_TIMEOUT=
# 上传失败重试次数，以及退避基数（秒）：第 n 次失败后等 基数 × 2^n 秒
PCTIME_RETRY_COUNT=
PCTIME_RETRY_BACKOFF=
# 后台线程多久检查一次该不该上传（秒）。1 小时是为了「开机后尽快补传昨天」，
# 不等于每小时传一次 —— 真正决定传不传的是本地的日期水位线。
PCTIME_UPLOAD_CHECK_INTERVAL=

# 可选完整根 URL（优先于 HOST/PORT），不要在这里附加 /api/v1。
# PCTIME_SERVER_URL=https://YOUR_PUBLIC_IP
# 顺带重传最近几天（天），用来容忍「服务端换了库」这种情况
PCTIME_RESEND_RECENT_DAYS=
