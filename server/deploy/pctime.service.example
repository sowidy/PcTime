[Unit]
Description=PcTime usage collection API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pctime
Group=pctime
WorkingDirectory=/opt/projects/PcTime/server
ExecStart=/opt/projects/PcTime/.venv/bin/python /opt/projects/PcTime/server/run.py
Environment=TZ=Asia/Shanghai
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
