USAGETIME_DB_HOST=127.0.0.1
USAGETIME_DB_PORT=3306
USAGETIME_DB_USER=usagetime
USAGETIME_DB_PASSWORD=
USAGETIME_DB_NAME=usagetime
# 1 initializes missing tables; 0 checks existing tables without DDL.
USAGETIME_DB_INIT_SCHEMA=1
USAGETIME_HOST=0.0.0.0
USAGETIME_PORT=8000
USAGETIME_ADMIN_TOKEN=
USAGETIME_MAX_DAYS=400
USAGETIME_MAX_APPS=2000

# Send yesterday's complete report at 00:03 in the server's local timezone.
USAGETIME_MAIL_TIME=00:03:00
USAGETIME_MAIL_TRACKING=1
# Optional SMTP; empty host disables mail and never prevents receiving uploads.
USAGETIME_SMTP_HOST=
USAGETIME_SMTP_PORT=465
USAGETIME_SMTP_USER=
USAGETIME_SMTP_PASSWORD=
USAGETIME_SMTP_SSL=1
USAGETIME_MAIL_FROM=
USAGETIME_MAIL_ENABLED=1
USAGETIME_MAIL_SCHEDULER=1
USAGETIME_MAIL_CATCHUP_DAYS=2
USAGETIME_MAIL_WEEKLY_DAY=6
