PCTIME_DB_HOST=127.0.0.1
PCTIME_DB_PORT=3306
PCTIME_DB_USER=pctime
PCTIME_DB_PASSWORD=
PCTIME_DB_NAME=pctime
# 1 initializes missing tables; 0 checks existing tables without DDL.
PCTIME_DB_INIT_SCHEMA=1
PCTIME_HOST=0.0.0.0
PCTIME_PORT=8000
PCTIME_ADMIN_TOKEN=
PCTIME_MAX_DAYS=400
PCTIME_MAX_APPS=2000

# Send yesterday's complete report at 00:03 in the server's local timezone.
PCTIME_MAIL_TIME=00:03:00
PCTIME_MAIL_TRACKING=1
# Plain-text detail limits (0 displays all); charts group remaining time as Other.
PCTIME_MAIL_MAX_APPS=60
PCTIME_MAIL_MAX_SITES=40
PCTIME_MAIL_CHART_SERIES=8
# Optional SMTP; empty host disables mail and never prevents receiving uploads.
PCTIME_SMTP_HOST=
PCTIME_SMTP_PORT=465
PCTIME_SMTP_USER=
PCTIME_SMTP_PASSWORD=
PCTIME_SMTP_SSL=1
PCTIME_MAIL_FROM=
PCTIME_MAIL_ENABLED=1
PCTIME_MAIL_SCHEDULER=1
PCTIME_MAIL_CATCHUP_DAYS=2
PCTIME_MAIL_WEEKLY_DAY=6
